{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logbutler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  // compatibility_date は、2 週間ルールで固定した workerd が対応する最新日 (2026-10-13)。作業日 2026-10-28 は workerd が拒否する。
  // CIMD (Client ID Metadata Document) を使わない M01 では global_fetch_strictly_public は不要。
  // nodejs_compat は必要になったときだけ足す。
  "compatibility_flags": [],
  "observability": { "enabled": true },
  "kv_namespaces": [
    // ローカル開発・テスト用 (wrangler dev / vitest)。本番の id は env.production 側に書く。
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
  ],
  "vars": {
    // これらは秘密ではない。デプロイ前に実値へ差し替える。
    "BACKLOG_SPACE_HOST": "example.backlog.com",
    "PUBLIC_BASE_URL": "https://logbutler.example.com"
  },
  // secrets (wrangler secret put): BACKLOG_CLIENT_ID, BACKLOG_CLIENT_SECRET

  // --- 本番環境 (wrangler deploy --env production / mise run deploy) ---
  // 名前付き環境は vars / kv_namespaces / routes / observability を継承しないので、ここで全部書く。
  // `<...>` のプレースホルダは、デプロイ前に docs/runbook.md の手順で実値へ書き換える。
  // プレースホルダのまま起動した Worker は、設定チェックで /healthz 以外が 500 になる (ADR 0010)。
  "env": {
    "production": {
      "name": "logbutler",
      "observability": { "enabled": true },
      "kv_namespaces": [
        // 書き換え 1: `wrangler kv namespace create OAUTH_KV` が返す id (32 桁の 16 進)。
        // 下の値はダミー (dry-run 用)。デプロイ前に実 id へ。
        { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
      ],
      "routes": [
        // 書き換え 2: 公開するドメイン。<domain> を実際のホスト名 (例 logbutler.example.com) にする。
        // そのドメインの DNS ゾーンが同じ Cloudflare アカウントにあること。
        { "pattern": "<domain>", "custom_domain": true }
      ],
      "vars": {
        // 書き換え 3: Backlog のスペースのホスト名 (例 example.backlog.com)。スキーム・スラッシュなし。
        "BACKLOG_SPACE_HOST": "<space>.backlog.com",
        // 書き換え 4: 上の routes と同じホストの https オリジン (末尾スラッシュ・パスなし)。
        // Backlog の OAuth リダイレクト URI は `${PUBLIC_BASE_URL}/callback`。
        "PUBLIC_BASE_URL": "https://<domain>"
      }
      // secrets (wrangler secret put <NAME> --env production): BACKLOG_CLIENT_ID, BACKLOG_CLIENT_SECRET
    }
  }
}
