{
  "$schema": "node_modules/wrangler/config-schema.json",
  // このファイルは upstream の共有設定で、ローカル開発 (wrangler dev) とテスト (vitest) が読む。
  // デプロイには使わない: アカウント固有の値 (Worker 名・KV id・ドメイン・Backlog スペース) をここに書くと、
  // upstream の変更を pull するときに競合する。デプロイ用の設定は `mise run deploy:render` が、
  // このファイルと LOGBUTLER_* 環境変数から wrangler.deploy.jsonc (gitignore 済み) に生成する (ADR 0011)。
  // 生成時は name / kv_namespaces の OAUTH_KV の id / vars の BACKLOG_SPACE_HOST・PUBLIC_BASE_URL / routes / workers_dev だけが差し替わる。
  // それ以外 (main, compatibility_date, compatibility_flags, observability, ほかの bindings など) は、ここに書いたものがそのまま下流に届く。
  "name": "logbutler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  // compatibility_date は、2 週間ルールで固定した workerd が対応する最新日 (2026-10-13)。作業日 2026-10-28 は workerd が拒否する。
  // CIMD (Client ID Metadata Document) を使わない M01 では global_fetch_strictly_public は不要。
  // nodejs_compat は必要になったときだけ足す。
  "compatibility_flags": [],
  "observability": { "enabled": true },
  "kv_namespaces": [
    // ローカル開発・テスト用のダミー id。デプロイ時は LOGBUTLER_KV_NAMESPACE_ID で差し替わる。
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
  ],
  "vars": {
    // ローカル開発・テスト用のダミー。デプロイ時は LOGBUTLER_BACKLOG_SPACE_HOST / LOGBUTLER_PUBLIC_BASE_URL で差し替わる。
    "BACKLOG_SPACE_HOST": "example.backlog.com",
    "PUBLIC_BASE_URL": "https://logbutler.example.com"
  }
  // secrets (デプロイ先で wrangler secret put / --secrets-file): BACKLOG_CLIENT_ID, BACKLOG_CLIENT_SECRET
}
